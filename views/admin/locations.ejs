<%- include('../partials/header', { title: 'Admin - Locations' }) %>

<main class="page">
  <section class="card card-wide">
    <%- include('../partials/admin-nav', { active: 'locations' }) %>

    <h1>Venues</h1>
    <p class="subtitle">These venues populate the tour stop dropdown on the public question form.</p>

    <% if (error) { %>
      <p class="alert alert-error"><%= error %></p>
    <% } %>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% locations.forEach(function(location) { %>
          <tr>
            <td>
              <form action="/admin/locations/<%= location.id %>/edit" method="POST" class="inline-form">
                <input type="text" name="name" value="<%= location.name %>" required />
                <button type="submit">Save</button>
              </form>
            </td>
            <td>
              <form action="/admin/locations/<%= location.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this location?');">
                <button type="submit" class="button-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <h2>Add a Venue</h2>
    <form action="/admin/locations" method="POST" class="question-form">
      <label for="name">Venue name</label>
      <input type="text" name="name" id="name" required placeholder="e.g. The Grosvenor, Sheffield" />
      <button type="submit">Add Venue</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>

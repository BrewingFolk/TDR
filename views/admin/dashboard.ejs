<%- include('../partials/header', { title: 'Admin - Questions' }) %>

<main class="page">
  <section class="card card-wide">
    <%- include('../partials/admin-nav', { active: 'questions' }) %>

    <h1>Submitted Questions</h1>

    <form action="/admin/present" method="GET" class="present-form">
      <label for="presentLocationId">Present questions for</label>
      <select name="locationId" id="presentLocationId" required>
        <% locations.forEach(function(location) { %>
          <option value="<%= location.id %>"><%= location.name %></option>
        <% }); %>
      </select>
      <button type="submit">Start Presenting Questions</button>
    </form>

    <% if (questions.length === 0) { %>
      <p class="subtitle">No questions have been submitted yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Submitted</th>
            <th>Name</th>
            <th>Venue</th>
            <th>Question</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% questions.forEach(function(q) { %>
            <tr>
              <td><%= new Date(q.createdAt).toLocaleString() %></td>
              <td><%= q.name || '—' %></td>
              <td><%= locationNames[q.locationId] || 'Unknown' %></td>
              <td><%= q.question %></td>
              <td>
                <form action="/admin/questions/<%= q.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this question?');">
                  <button type="submit" class="button-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>

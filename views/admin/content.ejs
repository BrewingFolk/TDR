<%- include('../partials/header', { title: 'Admin - Content' }) %>

<main class="page">
  <section class="card card-wide">
    <%- include('../partials/admin-nav', { active: 'content' }) %>

    <h1>Hero Text</h1>
    <p class="subtitle">
      Edit the copy shown in the amber hero section on the public page.
      HTML tags (e.g. <code>&lt;strong&gt;</code>, <code>&lt;em&gt;</code>, <code>&lt;br&gt;</code>, <code>&lt;a href="..."&gt;</code>) are rendered as-is, so double-check anything you paste in.
    </p>

    <% if (saved) { %>
      <p class="alert alert-success">Saved.</p>
    <% } %>
    <% if (error) { %>
      <p class="alert alert-error"><%= error %></p>
    <% } %>

    <form action="/admin/content" method="POST" class="question-form">
      <label for="eyebrow">Eyebrow</label>
      <input type="text" name="eyebrow" id="eyebrow" value="<%= content.eyebrow %>" placeholder="Verdant Brewing Co. × The Designers Republic™" />

      <label for="title">Title</label>
      <input type="text" name="title" id="title" required value="<%= content.title %>" placeholder="40 Years of TDR™ Tour" />

      <label for="subtitle">Subtitle</label>
      <input type="text" name="subtitle" id="subtitle" value="<%= content.subtitle %>" placeholder="Provoke response, create dialogue." />

      <label for="copy">Main copy</label>
      <textarea name="copy" id="copy" rows="6" required><%= content.copy %></textarea>

      <label for="meta">Meta line</label>
      <input type="text" name="meta" id="meta" value="<%= content.meta %>" placeholder="Autumn 2026. Ten venues. Ask your question before the night." />

      <button type="submit">Save</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
